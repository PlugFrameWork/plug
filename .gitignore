# =============================================================================
# plug — .gitignore
# =============================================================================
# Rule: ignore build artifacts, secrets, and OS/IDE noise.
# Commit: source code, manifests, configs, scripts, docs, assets.
# =============================================================================


# ── Rust ─────────────────────────────────────────────────────────────────────
/plug.app/rt/target/
Cargo.lock                        # Library crate: Cargo.lock is intentionally not committed

# ── C / C++ compiled artifacts ───────────────────────────────────────────────
*.obj
*.o
*.pch
*.gch
*.su                              # GCC stack-usage files

# ── Linker & archive artifacts ───────────────────────────────────────────────
*.lib
*.a
*.exp
*.ilk
*.pdb                             # MSVC program database (debug info)
*.map
*.def

# ── Shared / dynamic libraries ───────────────────────────────────────────────
*.dll
*.so
*.so.*
*.dylib

# ── Executables ──────────────────────────────────────────────────────────────
*.exe
*.out

# ── Toolchain sidecar files (generated by builder.py) ────────────────────────
*.toolchain

# ── CMake build directories & generated files ────────────────────────────────
**/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json             # Editor convenience — regenerate locally

# ── Ninja ────────────────────────────────────────────────────────────────────
.ninja_deps
.ninja_log

# ── Generated RC / manifest files ────────────────────────────────────────────
# plug_manifest.rc is generated by builder.py from plug.manifest at build time.
# The source plug.manifest IS committed; the generated .rc is not.
plug.cross/windows/plug_manifest.rc

# ── Release output directory ─────────────────────────────────────────────────
# Contains compiled binaries. Built locally via builder.py or in CI.
plug.cross/release/

# ── WASM compiled plugin fixtures (generated at test time) ───────────────────
tests/fixtures/build/

# ── Test run artifacts ───────────────────────────────────────────────────────
tests/.artifacts/

# ── Plugin runtime directory (deployed, not source) ──────────────────────────
plugins/*/
# Keep the plugins/ dir itself tracked (via .gitkeep or plugin.toml)
!plugins/.gitkeep
!plugins/plugin.toml
# Allow committing the official pTerm plugin binary file directly on GitHub
!plugins/pTerm

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.env.*                            # Any .env variant — never commit secrets

# ── Secrets & credentials ────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets.*
*secret*
*credential*
*password*
auth.json
token.json

# ── UPX compressed artefacts ─────────────────────────────────────────────────
*.upx

# ── IDE & editor noise ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.bak
.project
.cproject
.classpath
*.sublime-workspace
*.sublime-project

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Windows Developer Drive / junction artifacts ──────────────────────────────
*.lnk

# ── Temporary & workspace files ──────────────────────────────────────────────
*.tmp
scratch/